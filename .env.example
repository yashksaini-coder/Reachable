# Copy to .env (worker) and web/.env.local (web). Never commit either.
# The token is server-side only. Never prefix any of these NEXT_PUBLIC_.
HYDRA_URI=bolt://127.0.0.1:7687
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_DATABASE=default
HYDRA_TOKEN=local-development-token-32-bytes
# Optional: raises GitHub API limits from 60/h to 5000/h during ingest
GITHUB_TOKEN=
